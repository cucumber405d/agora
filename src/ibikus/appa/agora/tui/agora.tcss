/* Classic Far Manager palette */
Screen {
    background: #000080;
    color: #c0c0c0;
}

#main {
    height: 1fr;
}

#files {
    width: 32;
    background: #000080;
    border: double #00ffff;
    border-title-color: #ffffff;
    border-subtitle-color: #ffff00;
}

#files > .tree--cursor {
    background: #008080;
    color: #000000;
}

#right {
    width: 1fr;
}

#prompt {
    height: 8;
    background: #000080;
    color: #ffffff;
    border: double #00ffff;
    border-title-color: #ffffff;
}

#feed {
    height: 1fr;
    background: #000080;
    border: double #00ffff;
    border-title-color: #ffffff;
}

#feed Collapsible {
    background: #000080;
    border-top: none;
    padding-left: 0;
}

#feed .critique {
    color: #00ffff;
    padding-left: 2;
    margin-bottom: 1;
}

#feed .final {
    color: #ffff00;
    margin-bottom: 1;
}

#feed .error {
    color: #ff5555;
}

#status {
    height: 1;
    background: #008080;
    color: #000000;
}

Footer {
    background: #000000;
}

Footer .footer-key--key {
    background: #000000;
    color: #ffffff;
}

Footer .footer-key--description {
    background: #008080;
    color: #000000;
}

/* Dialogs */
ModalScreen {
    align: center middle;
    background: #000000 50%;
}

.dialog {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    background: #008080;
    color: #ffffff;
    border: double #ffffff;
    padding: 0 1;
}

#models .role {
    grid-size: 2;
    grid-columns: 14 1fr;
    grid-rows: 3;
    height: auto;
}

#models .role-title {
    color: #ffff00;
    margin-top: 1;
}

#models-error {
    color: #ff5555;
    height: auto;
}

#models-buttons {
    height: 3;
    align-horizontal: right;
}

/* Red error box (Far style) */
#error-box {
    width: 80%;
    max-width: 100;
    height: auto;
    background: #aa0000;
    color: #ffffff;
    border: double #ffffff;
    border-title-color: #ffff00;
    border-title-style: bold;
    padding: 0 1;
}

#error-body {
    background: #aa0000;
    color: #ffffff;
    margin: 1 0;
}

#error-buttons {
    height: 3;
    align-horizontal: center;
}

#error-buttons Button {
    margin: 0 1;
    background: #c0c0c0;
    color: #000000;
}

#feed .critique.warning {
    color: #ffff55;
}
